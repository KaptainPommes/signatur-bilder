PORT=3000

# Muss ein langer, zufälliger Wert sein. Erzeugen z.B. mit:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bitte-ersetzen-mit-zufaelligem-wert

# Auf "true" setzen, wenn die App per HTTPS erreichbar ist (empfohlen im Internet).
COOKIE_SECURE=false
